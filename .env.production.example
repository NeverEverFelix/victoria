# Template for production configuration.
# Real production values should be managed by the hosting provider.
# Do not commit real secrets.

APP_ENV=production
NODE_ENV=production

# Database
# Replace every placeholder before booting production; the parser rejects example hosts and placeholder passwords.
DATABASE_URL=postgresql://victoria:password@prod-db.example.com:5432/victoria_prod

# AI
OPENAI_API_KEY=

# Use mock until the real AI adapter has been wired and audited.
OPENAI_MODEL=mock
OPENAI_FINANCIAL_MOMENT_ENABLED=false
OPENAI_AGENT_TEAM_ENABLED=false

# Banking and money movement
PLAID_CLIENT_ID=
PLAID_SECRET=

# Use sandbox until production banking reads and writes have separate audited adapters.
PLAID_ENV=sandbox

# Use mock_ledger until real transfers have been fully approved, audited, and tested.
MONEY_MOVEMENT_MODE=mock_ledger

# Auth
AUTH_SECRET=
