# Template for production configuration.
# Real production values should be managed by the hosting provider.
# Do not commit real secrets.

APP_ENV=production
NODE_ENV=production

# Database
# Replace every placeholder before booting production; the parser rejects example hosts and placeholder passwords.
DATABASE_URL=postgresql://victoria:password@prod-db.example.com:5432/victoria_prod
DB_SSL=true
ALLOW_DB_MIGRATE=false

# AI
OPENAI_API_KEY=

# Use mock until the real AI adapter has been wired and audited.
OPENAI_MODEL=mock

# Banking and money movement
PLAID_CLIENT_ID=
PLAID_SECRET=

# Plaid is not wired into production and financial-data reads are outside the MVP.
PLAID_ENV=sandbox
PLAID_FINANCIAL_PROFILE_ENABLED=false

# Use mock_ledger until real transfers have been fully approved, audited, and tested.
MONEY_MOVEMENT_MODE=mock_ledger

# Auth
# Supabase Auth verifies end-user bearer tokens for authenticated API routes.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Random secret (32+ bytes), set in Vercel for the protected retention cron.
CRON_SECRET=
# AUTH_SECRET is used only by the local mock signed-session route; production uses Supabase Auth.
AUTH_SECRET=
