# Template for staging configuration.
# Real staging values should be managed by the hosting provider.
# Do not commit real secrets.

APP_ENV=staging
NODE_ENV=production

# Database
DATABASE_URL=postgresql://victoria:password@staging-db.example.com:5432/victoria_staging
DB_SSL=true
ALLOW_DB_MIGRATE=false

# AI
OPENAI_API_KEY=
OPENAI_MODEL=mock
OPENAI_FINANCIAL_MOMENT_ENABLED=false
OPENAI_AGENT_TEAM_ENABLED=false
OPENAI_MEMORY_EXTRACTION_ENABLED=true
OPENAI_PERSONALIZED_REPLIES_ENABLED=true
OPENAI_EPISODIC_SUMMARIES_ENABLED=true

# Banking and money movement
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_FINANCIAL_PROFILE_ENABLED=false
PLAID_TOKEN_ENCRYPTION_KEY=
PLAID_TOKEN_ENCRYPTION_KEY_VERSION=v1
MONEY_MOVEMENT_MODE=mock_ledger

# Auth
SUPABASE_URL=https://your-staging-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Random secret (32+ bytes), set in Vercel for the protected retention cron.
CRON_SECRET=
# AUTH_SECRET is used only by the local mock signed-session route.
AUTH_SECRET=
