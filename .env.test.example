# Copy this file to .env.test for local test runs.
# Tests should use isolated data and mocked external services by default.

APP_ENV=test
NODE_ENV=test

# Database
DATABASE_URL=postgresql://victoria:password@localhost:5432/victoria_test

# AI
OPENAI_API_KEY=test-openai-key
OPENAI_MODEL=mock
OPENAI_FINANCIAL_MOMENT_ENABLED=false

# Banking and money movement
PLAID_CLIENT_ID=test-plaid-client-id
PLAID_SECRET=test-plaid-secret
PLAID_ENV=sandbox
MONEY_MOVEMENT_MODE=mock_ledger

# Auth
AUTH_SECRET=test-auth-secret
