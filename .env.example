# Copy this file to .env.local for local development.
# Do not commit real secrets.

APP_ENV=local
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:local-only-password@127.0.0.1:5433/victoria_local
DB_SSL=false
ALLOW_DB_MIGRATE=false

# AI
OPENAI_API_KEY=local-openai-key
OPENAI_MODEL=mock
# Optional semantic-memory model; local persistent memory uses it when a real API key is configured.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_FINANCIAL_MOMENT_ENABLED=false
OPENAI_AGENT_TEAM_ENABLED=false
OPENAI_MEMORY_EXTRACTION_ENABLED=true
OPENAI_PERSONALIZED_REPLIES_ENABLED=true
OPENAI_EPISODIC_SUMMARIES_ENABLED=true

# Chat memory defaults to in-process mocks. Set to "persistent" only after
# applying local migrations to the loopback *_local database above.
VICTORIA_MEMORY_MODE=mock

# Banking and money movement
PLAID_CLIENT_ID=local-plaid-client-id
PLAID_SECRET=local-plaid-secret
PLAID_ENV=sandbox
PLAID_FINANCIAL_PROFILE_ENABLED=false
# Generate a base64-encoded 32-byte key for explicit local sandbox runtime work; never reuse a real key here.
PLAID_TOKEN_ENCRYPTION_KEY=
MONEY_MOVEMENT_MODE=mock_ledger

# Auth
AUTH_SECRET=replace-with-a-random-32-byte-local-secret
# Optional Supabase values are used only by the persistent memory runtime.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
